{
	"name": "irvannoerfazri/gamestuff-blocks",
	"description": "A lightweight, WordPress-native collection of Gutenberg blocks for documentation, wiki, and knowledge base websites.",
	"version": "1.11.0",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Irvan Noerfazri"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.4",
		"phpcompatibility/phpcompatibility-wp": "^3.0@dev"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint:php": "phpcs",
		"lint:php-fix": "phpcbf"
	}
}