{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,

	"name": "gamestuff/timeline",

	"version": "1.0.0",

	"title": "GameStuff Timeline",

	"category": "gamestuff",

	"icon": "editor-ol",

	"description": "Displays sequential information (heart events, walkthroughs, quests, etc.) as a simple vertical timeline.",

	"keywords": [ "timeline", "sequence", "chronology", "gamestuff" ],

	"textdomain": "gamestuff-blocks",

	"attributes": {
		"timelineType": {
			"type": "string",
			"default": "default"
		}
	},

	"supports": {
		"html": false,
		"reusable": false
	},

	"editorScript": "file:./index.js",

	"editorStyle": "file:./index.css",

	"style": "file:./style-index.css"
}
