{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,

	"name": "gamestuff/toc",

	"version": "1.0.0",

	"title": "GameStuff TOC",

	"category": "gamestuff",

	"icon": "list-view",

	"description": "Automatic table of contents built from the article's headings, with direct links to each section.",

	"keywords": [ "toc", "table of contents", "daftar isi", "gamestuff" ],

	"textdomain": "gamestuff-blocks",

	"attributes": {
		"title": {
			"type": "string",
			"default": "Daftar Isi"
		}
	},

	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false
	},

	"editorScript": "file:./index.js",

	"editorStyle": "file:./index.css",

	"style": "file:./style-index.css",

	"render": "file:./render.php"
}
